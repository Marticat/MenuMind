PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/menumind.sqlite
NODE_ENV=development
# template works without a key. Set openai-compatible for real LLM generation.
LLM_PROVIDER=template
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Luna from the project proposal; requires access in your OpenAI API project.
LLM_MODEL=gpt-5.6-luna
# Luna supports none for low-latency generation. Leave blank for other providers.
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_MS=8500
# Production: set APP_ORIGIN to the HTTPS site URL and NODE_ENV=production.
# TRUST_PROXY=1 only behind one trusted reverse proxy.
