{
  "name": "menumind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "node server/index.mjs",
    "test": "node --test server/tests/api.test.mjs server/tests/personalization.test.mjs",
    "test:e2e": "npm test --workspace frontend",
    "format": "prettier --write server frontend/src frontend/tests frontend/*.ts package.json README.md",
    "format:check": "prettier --check server frontend/src frontend/tests frontend/*.ts package.json README.md"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0"
  }
}
